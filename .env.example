# Copy to .env and adjust. All values have defaults in docker-compose.yml.
DB_NAME=fitness
DB_USER=fitness
DB_PASSWORD=fitness
DB_PORT=5432
# TypeORM auto-creates/updates tables. Set to false once you introduce migrations.
DB_SYNC=true

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Decides what "today" and "this week" mean for program tracking & stats.
TZ=Asia/Baku

API_PORT=3000
WEB_PORT=8080
